<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the release workflow.
  Paste this into the SignPath project (Artifact configurations > default).

  The workflow uploads the exe with actions/upload-artifact, which zips it,
  so the root element is <zip-file>. Product name and version are enforced
  as the SignPath Foundation requires; the version comes from Cargo.toml via
  the 'version' parameter the workflow passes.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="audio-output-device-switcher.exe"
             product-name="Audio Output Device Switcher"
             product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
